<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Art1"
    android:background="#E3FFBF">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/barrainferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="10dp"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:id="@+id/reg"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/regresar" />
                <TextView
                    android:id="@+id/tvTituloPantallaArt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="16"
                    android:gravity="center"
                    android:text="Artículos"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:layout_marginEnd="30dp"
                    android:layout_marginTop="11dp"/>

            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="24dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="0dp"
                    android:layout_marginTop="175dp"
                    android:layout_marginBottom="-60dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="65dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="90dp"
                        android:paddingHorizontal="24dp"
                        android:paddingBottom="450dp">

                        <TextView
                            android:id="@+id/textView8"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/txt36"
                            android:textSize="20sp"
                            android:textAlignment="center"/>

                        <TextView
                            android:id="@+id/textViewart2subtit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/txt45"
                            android:layout_marginTop="35dp"
                            android:textAlignment="center"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textViewcontlav"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp"
                            android:layout_marginBottom="30dp"
                            android:justificationMode="inter_word"
                            android:text="@string/txt46"
                            android:textSize="12sp"/>

                        <ImageView
                            android:id="@+id/imageView10"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginTop="-50dp"
                            android:layout_marginBottom="-20dp"
                            android:src="@drawable/lav_imp" />

                        <TextView
                            android:id="@+id/textViewrefri_boc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/txt47"
                            android:layout_marginTop="35dp"
                            android:textAlignment="center"
                            android:textSize="14sp" />

                        <TextView
                        android:id="@+id/textViewref"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="30dp"
                        android:layout_marginBottom="30dp"
                        android:justificationMode="inter_word"
                        android:text="@string/txt48"
                        android:textSize="12sp"/>

                        <ImageView
                            android:id="@+id/imageView11"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginTop="-50dp"
                            android:layout_marginBottom="-20dp"
                            android:src="@drawable/refribocina" />

                        <TextView
                            android:id="@+id/textViewrefri_boiler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/txt49"
                            android:layout_marginTop="35dp"
                            android:textAlignment="center"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textViewrefri"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="30dp"
                            android:layout_marginBottom="30dp"
                            android:justificationMode="inter_word"
                            android:text="@string/txt50"
                            android:textSize="12sp"/>

                        <ImageView
                            android:id="@+id/imageView13"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:layout_marginTop="-50dp"
                            android:layout_marginBottom="-20dp"
                            android:src="@drawable/boiler_mac" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <ImageView
                    android:id="@+id/imageViewim"
                    android:layout_width="130dp"
                    android:layout_height="188dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="50dp"
                    android:src="@drawable/apelec" />

            </FrameLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/barrainferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:id="@+id/calculadora"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imcalculadora"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/calculadora" />

            <TextView
                android:id="@+id/textviewCal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calculadora"
                android:textColor="#111111"
                android:textSize="9sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/inicio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iminicio"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/inicio" />

            <TextView
                android:id="@+id/textviewinicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Inicio"
                android:textColor="#111111"
                android:textSize="9sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/calendario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imcalendario"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Calendario"
                android:src="@drawable/calendario" />

            <TextView
                android:id="@+id/textviewCalendario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Calculadora semanal"
                android:textColor="#111111"
                android:textSize="9sp" />

        </LinearLayout>


    </LinearLayout>




</androidx.constraintlayout.widget.ConstraintLayout>